# Copy to .env.local and fill in from your Supabase project settings (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used by scripts/seed.ts,
# scripts/invite-client.ts, and the client add/remove and tour-reminder paths
# to reach the Supabase Admin API.
SUPABASE_SERVICE_ROLE_KEY=

# Where auth emails and tour reminders send people back to. Optional: falls
# back to the request's own origin, so preview deployments link to the
# preview rather than to production.
NEXT_PUBLIC_SITE_URL=

# Outbound client email (tour reminders). Supabase's mailer only sends its
# own auth templates, so anything Harbour writes goes through Resend.
# EMAIL_FROM must be a verified sending domain, e.g. "Britton Taylor <updates@example.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Shared secret for the nightly tour-reminder cron. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`; the route refuses to run without one.
CRON_SECRET=

# Timezone the tours happen in, used to decide what "tomorrow" means.
# Optional; defaults to America/Los_Angeles.
TOUR_TIME_ZONE=

# Copy to .env.local and fill in from your Supabase project settings (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used only by scripts/seed.ts and
# scripts/invite-client.ts to create auth users via the Admin API.
SUPABASE_SERVICE_ROLE_KEY=
